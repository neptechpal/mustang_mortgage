// Public website module ("site"): Contact Form 7 replicas, the contact-page
// lead form and the footer newsletter sign-up all store one row here.

model FormSubmission {
  id         Int      @id @default(autoincrement())
  formKey    String   // "cf7:1767", "cf7:2651", "mmf:3012", "newsletter"
  formTitle  String   @default("")
  name       String   @default("") // best-effort submitter name (list view)
  email      String   @default("") // best-effort submitter email (list view)
  data       Json     @default("{}") // { fieldName: string | string[] }
  files      Json     @default("[]") // [{ field, fileId, name, size, mimeType, kind: "upload" | "signature" }]
  meta       Json     @default("{}") // { ip, userAgent, url, mail: { mail1, mail2 } }
  status     String   @default("new") // new | read
  createdAt  DateTime @default(now())

  @@index([formKey, createdAt])
  @@index([createdAt])
}

model Testimonial {
  id        Int      @id @default(autoincrement())
  clientName String
  content   String   // testimonial text
  role      String   @default("") // e.g., "First Home Buyer"
  rating    Int      @default(5) // 1-5
  approved  Boolean  @default(false)
  published Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published, createdAt])
}

model TwoFactorAuth {
  id        Int      @id @default(autoincrement())
  userId    Int      @unique
  secret    String   // base32-encoded TOTP secret
  backupCodes String // JSON array of backup codes
  verified  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model OtpToken {
  id        Int      @id @default(autoincrement())
  token     String   @unique // 6-digit OTP
  email     String   // client email
  linkToken String   @unique // unique token for secure link
  verified  Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email, expiresAt])
}

model SiteSettings {
  key       String   @id // e.g., "enquiry.email", "enquiry.recipients"
  value     Json
  updatedAt DateTime @updatedAt
}
