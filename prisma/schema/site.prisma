// Public website module ("site"): Contact Form 7 replicas, the contact-page
// lead form and the footer newsletter sign-up all store one row here.

model FormSubmission {
  id         Int      @id @default(autoincrement())
  formKey    String   // "cf7:1767", "cf7:2651", "mmf:3012", "newsletter"
  formTitle  String   @default("")
  name       String   @default("") // best-effort submitter name (list view)
  email      String   @default("") // best-effort submitter email (list view)
  data       Json     @default("{}") // { fieldName: string | string[] }
  files      Json     @default("[]") // [{ field, fileId, name, size, mimeType, kind: "upload" | "signature" }]
  meta       Json     @default("{}") // { ip, userAgent, url, mail: { mail1, mail2 } }
  status     String   @default("new") // new | read
  createdAt  DateTime @default(now())

  @@index([formKey, createdAt])
  @@index([createdAt])
}

// Client testimonials shown on the home page. Entered by staff in /admin/testimonials.
model Testimonial {
  id         Int      @id @default(autoincrement())
  clientName String
  content    String
  detail     String   @default("") // e.g. "First home buyer, Parramatta"
  rating     Int?     // optional 1-5; null = no stars shown
  published  Boolean  @default(false)
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([published, sortOrder])
}

// One-time email codes that unlock a client portal link. Codes are stored as HMAC hashes only.
model PortalOtp {
  id         Int       @id @default(autoincrement())
  caseId     Int
  codeHash   String
  sentTo     String    @default("") // masked address, for the audit trail
  attempts   Int       @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  ip         String    @default("")
  createdAt  DateTime  @default(now())

  @@index([caseId, createdAt])
}
